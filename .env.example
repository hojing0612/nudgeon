# Vercel과 로컬 서버에 실제 값을 환경변수로 등록하세요.
# 이 파일에는 실제 API 키를 넣지 않습니다.
YOUTH_POLICY_API_KEY=
ANTHROPIC_API_KEY=

# 운영자 도구에서 Anthropic 공식 월 사용액을 조회합니다. 일반 API 키와 다릅니다.
ANTHROPIC_ADMIN_KEY=
# NudgeOn 전용 Workspace 비용만 집계하려면 wrkspc_... ID를 등록합니다.
ANTHROPIC_NUDGEON_WORKSPACE_ID=

# Supabase Project Settings > API에서 확인합니다.
# anon key는 브라우저용 공개 키이며 service role key와 다릅니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버에서 정책 DB를 동기화할 때만 사용합니다. 브라우저에 노출하면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron이 정책 동기화 API를 호출할 때 사용하는 임의의 긴 비밀값
CRON_SECRET=
